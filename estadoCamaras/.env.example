# Base de datos
DB_URL=jdbc:mysql://localhost:3306/nombre_de_tu_base_de_datos
DB_USERNAME=nombre_de_usuario
DB_PASSWORD=nombre_de_contraseña

# Seguridad
JWT_SECRET=generar_un_secreto_aleatorio_de_32_bytes_o_mas

# Canal de notificaciones: whatsapp, telegram o consola
NOTIFICACIONES_CANAL=whatsapp

# WhatsApp (si NOTIFICACIONES_CANAL=whatsapp)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Telegram (si NOTIFICACIONES_CANAL=telegram)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=